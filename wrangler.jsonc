// Cloudflare yayın ayarı. Ürün/kategori sayfaları önce worker.js'ten geçer, diğer her şey doğrudan dosya olarak sunulur.
{
  "name": "gamika",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/gamika-girl", "/gamika-girl/", "/gamika-boy", "/gamika-boy/", "/urun/*", "/urunler", "/urunler/", "/kategori/*", "/seri/*", "/sitemap.xml", "/merchant-feed.xml"]
  },
  "routes": [
    { "pattern": "gamikatr.com", "custom_domain": true },
    { "pattern": "www.gamikatr.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Test dalları için önizleme linki (npx wrangler preview bu bloğu istiyor; boş kalabilir)
  "previews": {},
  "preview_urls": true
}
